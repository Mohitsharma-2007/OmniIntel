# OmniIntel - Environment Configuration
# Add your OpenRouter API key below

# OpenRouter API Key (Required) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model - Default uses "openrouter/free" auto-router
# Free models: openrouter/free, google/gemma-4-31b, nvidia/nemotron-3-nano-30b-a3b,
#              deepseek/deepseek-chat, mistralai/mistral-7b-instruct, meta-llama/llama-3.1-8b-instruct
# Paid models: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-exp
OPENROUTER_MODEL=openrouter/free

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Pathway Configuration
PATHWAY_CACHE_DIR=./data/cache
PATHWAY_DOCUMENT_DIR=./data/documents
PATHWAY_LICENSE_KEY=FCEAD8-FB338D-D5C783-AB9DBD-5E80B8-V3

# Data Source Configuration
STOCK_POLLING_INTERVAL=60
NEWS_POLLING_INTERVAL=300
DATA_FRESHNESS_THRESHOLD=3600

# Feature Flags
ENABLE_MOCK_DATA=true
